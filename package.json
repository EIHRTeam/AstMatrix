{
  "name": "astmatrix",
  "version": "0.1.0",
  "private": true,
  "description": "AstMatrix — offline-first cross-platform barcode and QR code plugin for Illustrator, Photoshop and Affinity",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @astmatrix/playground-web dev",
    "build": "node tooling/build-targets/build.mjs",
    "build:illustrator": "node tooling/build-targets/build.mjs illustrator",
    "build:photoshop": "node tooling/build-targets/build.mjs photoshop",
    "build:affinity": "node tooling/build-targets/build.mjs affinity",
    "build:web": "node tooling/build-targets/build.mjs web",
    "build:target": "node tooling/build-targets/build.mjs target",
    "package": "node tooling/packaging/package.mjs",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run --project conformance",
    "test:vector": "vitest run --project vector-golden",
    "test:react-state": "vitest run --project react-state",
    "test:compat": "vitest run --project compatibility",
    "test:host": "vitest run --project host-integration",
    "test:decode": "vitest run --project decode",
    "spike:m0:decode": "node tests/decode/run-m0.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:extendscript && pnpm spike:m0:rules && pnpm fmt:check && pnpm test",
    "spike:m0": "node tests/compatibility/spikes/build.mjs",
    "spike:m0:rules": "node tests/compatibility/spikes/check-rules.mjs",
    "check:extendscript": "node tooling/validate-extendscript.mjs",
    "benchmark:m1": "node tooling/benchmarks/run-m1.mjs",
    "decode:m1": "node tests/decode/run-m1.mjs",
    "check:web-bundles": "node tooling/build-targets/verify-web.mjs",
    "check:host-bundles": "node tooling/build-targets/verify-hosts.mjs"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "8.15.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
