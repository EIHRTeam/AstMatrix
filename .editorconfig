root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ExtendScript runs on a legacy engine; keep the file byte-stable for the host.
[*.jsx]
indent_size = 2
insert_final_newline = true
