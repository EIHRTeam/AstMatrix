{
  "manifestVersion": 5,
  "id": "com.u202f.astmatrix.photoshop.webview",
  "name": "AstMatrix WebUI",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "26.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "astmatrix.panel",
      "label": {
        "default": "AstMatrix WebUI"
      },
      "minimumSize": {
        "width": 320,
        "height": 460
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 620
      },
      "icons": []
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "webview": {
      "allow": "yes",
      "domains": [],
      "allowLocalRendering": "yes",
      "enableMessageBridge": "localOnly"
    },
    "launchProcess": {
      "schemes": ["https"]
    }
  }
}
