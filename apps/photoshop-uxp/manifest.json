{
  "manifestVersion": 5,
  "id": "com.u202f.astmatrix.photoshop",
  "name": "AstMatrix",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "astmatrix.panel",
      "label": {
        "default": "AstMatrix"
      },
      "minimumSize": {
        "width": 320,
        "height": 460
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 620
      },
      "icons": []
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
